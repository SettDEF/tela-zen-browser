+  // Tela: the reel button beside the Picture-in-Picture toggle.
+  static setupReelToggle(reel, toggle) {
+    if (!reel) {
+      return;
+    }
+    reel.hidden = toggle.hidden;
+    reel.setAttribute("position", toggle.getAttribute("position") || "left");
+  }
+
+  static telaReelHandlers(owner, reel) {
+    if (!reel) {
+      return;
+    }
+    const toggle = owner.pictureInPictureToggle;
+    if (toggle) {
+      const mirror = () => {
+        for (const name of ["policy", "position", "small-video", "medium-video", "has-used"]) {
+          if (toggle.hasAttribute(name)) {
+            reel.setAttribute(name, toggle.getAttribute(name));
+          } else {
+            reel.removeAttribute(name);
+          }
+        }
+        reel.hidden = toggle.hidden;
+      };
+      new owner.window.MutationObserver(mirror).observe(toggle, { attributes: true });
+      mirror();
+    }
+    const send = (name, data) => {
+      try {
+        owner.window.windowGlobalChild.getActor("TelaMediaSource").sendAsyncMessage(name, data);
+      } catch {}
+    };
+    reel.addEventListener("click", event => {
+      event.preventDefault();
+      event.stopPropagation();
+      send("TelaMedia:Reel", {
+        src: owner.video.currentSrc,
+        position: owner.video.currentTime,
+        frame: owner.window.document.documentURI,
+      });
+    });
+    reel.addEventListener("contextmenu", event => {
+      event.preventDefault();
+      event.stopPropagation();
+      send("TelaMedia:Menu", { x: event.screenX, y: event.screenY });
+    });
+  }
 };
 
