## Settings: Tor spaces.
## This routes a space through a local Tor proxy. It is circumvention, not
## anonymity - the copy must not suggest otherwise.

zen-tor-title = Tor Spaces
zen-tor-header = Routing a space through Tor
zen-tor-description = A space can send its traffic through a Tor proxy running on this machine. That changes where your traffic appears to come from. It is not anonymity: this browser is not Tor Browser, and it does not defend against fingerprinting or traffic analysis.
zen-tor-enabled =
    .label = Allow Tor spaces and windows
zen-tor-host-label = Proxy host
