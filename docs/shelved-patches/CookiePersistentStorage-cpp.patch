  * Parent class for our async storage listeners that handles the logging of
  * errors.
  ******************************************************************************/
+// A failure of the disk rather than of the file. Rebuilding on one moves the
+// whole jar aside, and on a full disk the new database stays empty.
+static bool IsEnvironmentalError(nsresult aRv) {
+  return aRv == NS_ERROR_FILE_NO_DEVICE_SPACE ||
+         aRv == NS_ERROR_STORAGE_IOERR || aRv == NS_ERROR_STORAGE_BUSY ||
+         aRv == NS_ERROR_FILE_IS_LOCKED || aRv == NS_ERROR_FILE_READ_ONLY ||
+         aRv == NS_ERROR_FILE_ACCESS_DENIED || aRv == NS_ERROR_OUT_OF_MEMORY;
+}
+
+static bool IsEnvironmentalSQLiteError(int32_t aResult) {
+  switch (aResult) {
+    case mozIStorageError::FULL:
+    case mozIStorageError::IOERR:
+    case mozIStorageError::BUSY:
+    case mozIStorageError::LOCKED:
+    case mozIStorageError::READONLY:
+    case mozIStorageError::NOMEM:
+    case mozIStorageError::CANTOPEN:
+    case mozIStorageError::PERM:
+      return true;
+    default:
+      return false;
+  }
+}
+
 class DBListenerErrorHandler : public mozIStorageStatementCallback {
  protected:
   explicit DBListenerErrorHandler(CookiePersistentStorage* dbState)
@@ -320,6 +345,17 @@ class DBListenerErrorHandler : public mozIStorageStatementCallback {
 
  public:
   NS_IMETHOD HandleError(mozIStorageError* aError) override {
+    int32_t sqliteResult = -1;
+    aError->GetResult(&sqliteResult);
+    if (IsEnvironmentalSQLiteError(sqliteResult)) {
+      // The cookies are still in memory and the file is intact; the next
+      // write can succeed once the disk recovers.
+      COOKIE_LOGSTRING(LogLevel::Warning,
+                       ("DBListenerErrorHandler::HandleError(): disk error %d "
+                        "during '%s'; keeping the database.",
+                        sqliteResult, GetOpType()));
+      return NS_OK;
+    }
     if (MOZ_LOG_TEST(gCookieLog, LogLevel::Warning)) {
       int32_t result = -1;
       aError->GetResult(&result);
@@ -989,6 +1025,12 @@ void CookiePersistentStorage::Activate() {
  * If RESULT_RETRY or RESULT_FAILED is returned, the caller should perform
  * cleanup of the default CookieStorage.
  */
+static CookiePersistentStorage::OpenDBResult RetryUnlessEnvironmental(
+    nsresult aRv) {
+  return IsEnvironmentalError(aRv) ? CookiePersistentStorage::RESULT_FAILURE
+                                   : CookiePersistentStorage::RESULT_RETRY;
+}
